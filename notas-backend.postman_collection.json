              "mode": "raw",
              "raw": "{\n  \"username\": \"Juean Perez\",\n  \"email\": \"juan.perez@test.com\",\n  \"password\": \"coral2024\",\n  \"password2\": \"coral2024\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register/",
