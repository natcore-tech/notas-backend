        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Convertimos la respuesta JSON a un objeto",
                  "const responseJson = pm.response.json();",
                  "",
                  "// Guardamos el access token directamente en tu variable de entorno 'token'",
                  "pm.environment.set(\"token\", responseJson.access);"
                ],
                "type": "text/javascript",
